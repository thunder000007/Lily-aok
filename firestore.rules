rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "boteditz999@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['blocked', 'admin']);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked']))
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'photoURL', 'updatedAt', 'bio', 'social'
          ]));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000
        && request.resource.data.likeUids is list
        && request.resource.data.likeUids.size() == 0;
      allow update: if signedIn()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mediaURL', 'likeUids'])
        && (
          resource.data.authorId == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeUids'])
            && request.resource.data.likeUids is list
            && resource.data.likeUids is list
            && (
              (
                request.resource.data.likeUids.size() == resource.data.likeUids.size() + 1
                && request.resource.data.likeUids.hasAll(resource.data.likeUids)
                && request.auth.uid in request.resource.data.likeUids
              )
              || (
                request.resource.data.likeUids.size() == resource.data.likeUids.size() - 1
                && resource.data.likeUids.hasAll(request.resource.data.likeUids)
                && request.auth.uid in resource.data.likeUids
              )
            )
          )
        );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}