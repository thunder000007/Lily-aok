rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','displayName','email','bio','photoURL','following','social','createdAt']);
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if isSelf(uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','text','imageURL','createdAt','likes','comments']);
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is list
          && request.resource.data.likes.size() <= 10000) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments is list
          && request.resource.data.comments.size() <= 500)
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','text','imageURL','createdAt','expiresAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 2;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.keys().hasOnly(['uid','text','createdAt']);
        allow update, delete: if false;
      }
    }
  }
}