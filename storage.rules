rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    // Profile images: any signed-in user may read; only the owner may upload.
    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Chat attachments: only members of the matching chat may access them.
    match /chats/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create, update: if isChatParticipant(chatId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isChatParticipant(chatId);
    }

    // Deny any paths not explicitly listed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
